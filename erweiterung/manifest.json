{
  "manifest_version": 2,
  "name": "Halo Spaces",
  "description": "Ein ruhiges, aufgeräumtes Design im Stil von macOS – mit farbigen Bereichen, Absenderbildern, Vorschau und vereinigtem Adressbuch.",
  "version": "3.0.1",
  "author": "sruf79",
  "browser_specific_settings": {
    "gecko": {
      "id": "mail-cards@sebastian.local",
      "strict_min_version": "128.0",
      "update_url": "https://raw.githubusercontent.com/sruf79/halo-spaces/main/updates.json"
    }
  },
  "background": {
    "page": "background.html"
  },
  "experiment_apis": {
    "mailCards": {
      "schema": "api/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "mailCards"
          ]
        ],
        "script": "api/implementation.js",
        "events": [
          "startup"
        ]
      }
    }
  },
  "homepage_url": "https://github.com/sruf79/halo-spaces"
}
